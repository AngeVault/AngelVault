/* ===== AngeVault Editor — thème « Noir » =====
   Noir pur, sans couleur ni image : uniquement des gris très sombres et un texte gris clair.
   @monochrome  (marqueur lu par ThemeManager : cadre caméra et grille du tileset en gris) */

QMainWindow#MainWindow {
    background-color: #000000;
    qproperty-borderColor: #282828;    /* liseré de la fenêtre (Windows 11) */
}

QWidget {
    color: #cdcdcd;
    selection-background-color: #414141;
    selection-color: #ffffff;
}
QLabel { color: #cdcdcd; background: transparent; }

QToolTip {
    background-color: #000000;
    color: #cdcdcd;
    border: 1px solid rgba(119, 119, 119, 0.45);
    border-radius: 6px;
    padding: 4px 8px;
}

/* ----- Barre de titre ----- */

TitleBar#titleBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(3, 3, 3, 1), stop:0.5 rgba(6, 6, 6, 1), stop:1 rgba(3, 3, 3, 1));
    border-bottom: 1px solid rgba(104, 104, 104, 0.40);
    qproperty-iconColor: #9b9b9b;               /* icônes réduire / agrandir / fermer */
}
TitleBar#titleBar[active="false"] { border-bottom: 1px solid rgba(119, 119, 119, 0.20); }

QLabel#titleLabel { color: #939393; font-size: 9pt; font-weight: 600; }
TitleBar#titleBar[active="false"] QLabel#titleLabel { color: #616161; }

QMenuBar#titleMenuBar { background: transparent; color: #b3b3b3; padding: 0px; spacing: 2px; }
TitleBar#titleBar[active="false"] QMenuBar#titleMenuBar { color: #616161; }
QMenuBar#titleMenuBar::item { background: transparent; padding: 5px 10px; border-radius: 7px; }
QMenuBar#titleMenuBar::item:selected { background-color: rgba(119, 119, 119, 0.20); color: #ffffff; }
QMenuBar#titleMenuBar::item:pressed  { background-color: rgba(104, 104, 104, 0.32); color: #ffffff; }

QPushButton#minimizeButton, QPushButton#maximizeButton, QPushButton#closeButton {
    background: transparent; border: none; border-radius: 0px; padding: 0px; margin: 0px;
}
QPushButton#minimizeButton:hover, QPushButton#maximizeButton:hover     { background-color: rgba(119, 119, 119, 0.20); }
QPushButton#minimizeButton:pressed, QPushButton#maximizeButton:pressed { background-color: rgba(119, 119, 119, 0.34); }
QPushButton#closeButton:hover   { background-color: #7a7a7a; }
QPushButton#closeButton:pressed { background-color: #616161; }

/* ----- Menus déroulants ----- */

QMenu {
    background-color: #000000;
    color: #cdcdcd;
    border: 1px solid rgba(119, 119, 119, 0.40);
    padding: 5px;
}
QMenu::item { padding: 6px 30px 6px 12px; border-radius: 6px; background: transparent; }
QMenu::item:selected { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #414141, stop:1 #3e3e3e); color: #ffffff; }
QMenu::item:disabled { color: #4d4d4d; }
QMenu::separator { height: 1px; background: rgba(119, 119, 119, 0.25); margin: 5px 8px; }
QMenu::indicator { width: 14px; height: 14px; margin-left: 4px; }
QMenu::right-arrow { margin-right: 6px; }

/* ----- Barre d'état ----- */

QStatusBar { background-color: rgba(3, 3, 3, 1); color: #8a8a8a; border-top: 1px solid rgba(119, 119, 119, 0.30); }
QStatusBar::item { border: none; }
QStatusBar QLabel { color: #8a8a8a; padding-right: 8px; }

QMessageBox { background-color: #000000; }

/* =====================================================================
   Panneaux (Hierarchy / Inspector / Project / Console / Tile Palette)
   ===================================================================== */

QMainWindow::separator { background: transparent; width: 6px; height: 6px; }
QMainWindow::separator:hover { background: rgba(104, 104, 104, 0.45); }

QDockWidget { color: #cdcdcd; font-weight: 600; }
QDockWidget::title {
    background: rgba(5, 5, 5, 1);
    padding: 6px 10px;
    border: 1px solid rgba(119, 119, 119, 0.28);
    border-bottom: 2px solid #686868;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    text-align: left;
}
QWidget#hierarchyPanel, QWidget#inspectorPanel, QWidget#projectPanel,
QWidget#consolePanel, QWidget#tilePalettePanel {
    background: rgba(4, 4, 4, 1);
    border: 1px solid rgba(119, 119, 119, 0.26);
    border-top: none;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}
QDockWidget::close-button, QDockWidget::float-button { border: none; border-radius: 4px; padding: 2px; background: transparent; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background: rgba(119, 119, 119, 0.22); }

/* Onglets des panneaux empilés */
QTabBar { qproperty-drawBase: 0; }
QTabBar::tab {
    background: rgba(4, 4, 4, 1);
    color: #797979;
    border: 1px solid rgba(119, 119, 119, 0.26);
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 5px 14px;
    margin-right: 2px;
}
QTabBar::tab:selected { background: rgba(9, 9, 9, 1); color: #ffffff; border-color: #686868; }
QTabBar::tab:hover:!selected { color: #cdcdcd; background: rgba(119, 119, 119, 0.20); }

/* Listes et arbres */
QTreeView, QListView, QListWidget, QTreeWidget {
    background: rgba(2, 2, 2, 1);
    color: #cdcdcd;
    border: 1px solid rgba(119, 119, 119, 0.24);
    border-radius: 8px;
    padding: 3px;
    outline: none;
}
QTreeView::item, QListView::item { padding: 3px 4px; border-radius: 5px; }
QTreeView::item:hover, QListView::item:hover { background: rgba(119, 119, 119, 0.18); }
QTreeView::item:selected, QListView::item:selected { background: #414141; color: #ffffff; }
QTreeView { show-decoration-selected: 0; }
QTreeView::branch, QTreeView::branch:selected { background: transparent; }
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings { image: url(:/resources/icons/branch_closed.png); }
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings { image: url(:/resources/icons/branch_open.png); }

/* Champs */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit, QPlainTextEdit {
    background: rgba(1, 1, 1, 1);
    color: #d7d7d7;
    border: 1px solid rgba(119, 119, 119, 0.30);
    border-radius: 6px;
    padding: 3px 6px;
    selection-background-color: #414141;
    selection-color: #ffffff;
}
/* Pas de flèches sur les champs numériques (molette / clavier). Largeur ET hauteur à 0 :
   avec seulement width: 0, Qt 6.12 laisse les flèches recouvrir le texte du champ. */
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    width: 0px;
    height: 0px;
    border: none;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus,
QTextEdit:focus, QPlainTextEdit:focus { border: 1px solid #787878; }
QLineEdit:read-only, QDoubleSpinBox:read-only, QSpinBox:read-only { color: #797979; }
QComboBox QAbstractItemView {
    background: #000000;
    color: #cdcdcd;
    border: 1px solid rgba(119, 119, 119, 0.40);
    selection-background-color: #414141;
    selection-color: #ffffff;
}

QPushButton {
    background: rgba(9, 9, 9, 1);
    color: #cdcdcd;
    border: 1px solid rgba(119, 119, 119, 0.32);
    border-radius: 7px;
    padding: 5px 12px;
}
QPushButton:hover   { border-color: #787878; background: rgba(13, 13, 13, 1); }
QPushButton:pressed { background: rgba(104, 104, 104, 0.40); }
QPushButton:disabled { color: #4d4d4d; }
QPushButton::menu-indicator { subcontrol-position: right center; right: 8px; }

QToolButton#panelToolButton, QToolButton#paletteTool,
QToolButton#consoleInfo, QToolButton#consoleWarning, QToolButton#consoleError {
    background: rgba(9, 9, 9, 1);
    color: #cdcdcd;
    border: 1px solid rgba(119, 119, 119, 0.30);
    border-radius: 6px;
    padding: 3px 9px;
    min-height: 18px;
}
QToolButton#panelToolButton:hover, QToolButton#paletteTool:hover { border-color: #686868; }
QToolButton#paletteTool:checked { background: #414141; border-color: #686868; color: #ffffff; }
QToolButton#consoleInfo:!checked, QToolButton#consoleWarning:!checked, QToolButton#consoleError:!checked {
    color: #616161;
    background: transparent;
}
QToolButton#consoleWarning:checked { color: #8a8a8a; }
QToolButton#consoleError:checked   { color: #a5a5a5; }

QCheckBox { color: #cdcdcd; spacing: 6px; }

QSplitter::handle { background: transparent; width: 5px; }
QSplitter::handle:hover { background: rgba(104, 104, 104, 0.45); }

/* Inspector */
QScrollArea#inspectorScroll, QWidget#inspectorContent { background: transparent; border: none; }
QLabel#inspectorEmpty { color: #797979; }
QLabel#inspectorId { color: #797979; padding: 0 4px; }
QLineEdit#inspectorName { font-weight: 600; padding: 5px 8px; }
QWidget#componentSection { background: rgba(6, 6, 6, 1); border: 1px solid rgba(119, 119, 119, 0.26); border-radius: 8px; }
QWidget#componentHeader { background: rgba(10, 10, 10, 1); border-top-left-radius: 8px; border-top-right-radius: 8px; }
QToolButton#componentToggle {
    background: transparent; border: none; color: #d7d7d7; font-weight: 600; padding: 4px 2px; text-align: left;
}
QToolButton#componentRemove { background: transparent; border: none; border-radius: 4px; color: #797979; padding: 2px 6px; }
QToolButton#componentRemove:hover { background: #7a7a7a; color: #ffffff; }
QWidget#componentBody QLabel { color: #898989; }
QLabel#fieldLabel { color: #cdcdcd; }
QLabel#axisLabelX { color: #a5a5a5; font-weight: 600; }
QLabel#axisLabelY { color: #787878; font-weight: 600; }
QPushButton#addComponentButton { padding: 7px 12px; font-weight: 600; border-color: rgba(188, 188, 188, 0.55); color: #a2a2a2; }
QPushButton#addComponentButton:hover { border-color: #8a8a8a; }

/* Project / Tile Palette / Console */
QLabel#projectPath { color: #797979; padding-left: 4px; }
QLabel#paletteSectionTitle { color: #8a8a8a; font-weight: 600; }
QLabel#paletteHelp { color: #797979; font-size: 8pt; }
QListWidget#paletteTerrains::item { padding: 3px 6px; }
QListWidget#consoleList::item { padding: 1px 4px; border-radius: 3px; }

QScrollBar:vertical, QScrollBar:horizontal { background: transparent; border: none; margin: 0px; }
QScrollBar:vertical   { width: 10px; }
QScrollBar:horizontal { height: 10px; }
QScrollBar::handle { background: rgba(119, 119, 119, 0.40); border-radius: 4px; min-height: 24px; min-width: 24px; margin: 2px; }
QScrollBar::handle:hover { background: rgba(104, 104, 104, 0.60); }
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page { background: none; border: none; width: 0px; height: 0px; }

/* Fond de la vue scène / jeu (autour de la carte) */
SfmlWidget { qproperty-clearColor: #000000; qproperty-backgroundImage: "none"; }
TilemapView { qproperty-backgroundImage: "none"; }

/* =====================================================================
   Fenêtres Input Manager / Systèmes
   ===================================================================== */
QDialog#inputSettingsDialog,
QDialog#systemsDialog { background-color: #000000; }
QDialog#inputSettingsDialog QTableWidget,
QDialog#systemsDialog QTableWidget {
    background: #000000;
    border: 1px solid rgba(119, 119, 119, 0.28);
    border-radius: 6px;
    gridline-color: transparent;
}
QDialog#inputSettingsDialog QHeaderView::section,
QDialog#systemsDialog QHeaderView::section {
    background: #000000;
    color: #797979;
    border: none;
    border-bottom: 1px solid rgba(119, 119, 119, 0.28);
    padding: 4px 6px;
}
QDialog#inputSettingsDialog QTableWidget QToolButton,
QDialog#systemsDialog QTableWidget QToolButton { background: transparent; border: none; }
QDialog#inputSettingsDialog QLabel#hintLabel,
QDialog#systemsDialog QLabel#hintLabel { color: #797979; }
QDialog#inputSettingsDialog QPushButton[capturing="true"],
QDialog#systemsDialog QPushButton[capturing="true"] { border: 1px solid #8a8a8a; font-style: italic; }

/* Fenêtre « Tileset » (Tile Palette > + / Modifier) */
QDialog#tileDefDialog { background-color: #000000; }
QDialog#tileDefDialog QLabel#hintLabel { color: #797979; }
QDialog#tileDefDialog QGroupBox {
    border: 1px solid rgba(119, 119, 119, 0.28);
    border-radius: 6px;
    margin-top: 14px;
    padding: 8px 6px 6px 6px;
}
QDialog#tileDefDialog QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #8a8a8a;
}
QDialog QScrollArea, QDialog QScrollArea > QWidget > QWidget { background: transparent; }

/* Menus et bulles : opaques (fenêtres à part) */
QMenu { background-color: #000000; }
QToolTip { background-color: #000000; }

/* =====================================================================
   Contrôles natifs : sans ces règles, Windows les dessine avec sa couleur d'accent (bleu)
   ===================================================================== */
QSlider::groove:horizontal { height: 4px; background: #1a1a1a; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #555555; border-radius: 2px; }
QSlider::add-page:horizontal { background: #1a1a1a; border-radius: 2px; }
QSlider::handle:horizontal { background: #9a9a9a; border: 1px solid #000000; width: 12px; margin: -5px 0; border-radius: 6px; }
QSlider::handle:horizontal:hover { background: #cdcdcd; }
QSlider::groove:vertical { width: 4px; background: #1a1a1a; border-radius: 2px; }
QSlider::handle:vertical { background: #9a9a9a; border: 1px solid #000000; height: 12px; margin: 0 -5px; border-radius: 6px; }

QCheckBox::indicator, QRadioButton::indicator, QGroupBox::indicator,
QTreeView::indicator, QListView::indicator, QTableView::indicator, QMenu::indicator {
    width: 13px; height: 13px; background: #000000; border: 1px solid #4d4d4d;
}
QCheckBox::indicator, QGroupBox::indicator, QTreeView::indicator, QListView::indicator,
QTableView::indicator, QMenu::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #8a8a8a; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked, QGroupBox::indicator:checked,
QTreeView::indicator:checked, QListView::indicator:checked, QTableView::indicator:checked,
QMenu::indicator:checked { background: #b3b3b3; border-color: #b3b3b3; }
QCheckBox::indicator:indeterminate { background: #555555; }
QCheckBox::indicator:disabled { border-color: #262626; }
QRadioButton { color: #cdcdcd; spacing: 6px; }

QComboBox::drop-down { border: none; width: 18px; background: transparent; }
QComboBox::down-arrow { width: 0; height: 0; border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 5px solid #8a8a8a; }
QComboBox QAbstractItemView { background: #000000; outline: none; }

QTableView, QTableWidget { background: #000000; color: #cdcdcd; gridline-color: #1a1a1a; border: 1px solid #262626; selection-background-color: #414141; }
QHeaderView, QHeaderView::section { background: #050505; color: #8a8a8a; border: none; border-bottom: 1px solid #262626; padding: 4px 6px; }
QTableCornerButton::section { background: #050505; border: none; }

QGroupBox { border: 1px solid #262626; border-radius: 6px; margin-top: 14px; padding: 8px 6px 6px 6px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; color: #8a8a8a; }

QProgressBar { background: #0a0a0a; border: 1px solid #262626; border-radius: 4px; color: #cdcdcd; text-align: center; }
QProgressBar::chunk { background: #555555; border-radius: 3px; }

QDialog, QMessageBox, QInputDialog, QFileDialog { background-color: #000000; }
QAbstractScrollArea { background: #000000; }
QToolButton { color: #cdcdcd; }
QToolButton:checked { background: #414141; }
