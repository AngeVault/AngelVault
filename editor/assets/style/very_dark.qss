/* ===== AngeVault Editor — thème « Très sombre » (sans image) =====
   Couleurs reprises du thème Kindred : nuit indigo (#1b1733), violet du ciel (#2c2552), lavande (#a99ae6),
   rose des pétales (#9c4a7a), bleu turquoise des lames (#3f8e9e), or des ornements (#a8884a), blanc de la fourrure.
   Panneaux presque noirs et presque opaques, accents discrets. */

QMainWindow#MainWindow {
    background-color: #07060c;
    qproperty-borderColor: #2a2340;    /* liseré de la fenêtre (Windows 11) */
}

QWidget {
    color: #cfc8e2;
    selection-background-color: #6e2752;
    selection-color: #ffffff;
}
QLabel { color: #cfc8e2; background: transparent; }

QToolTip {
    background-color: #100e1a;
    color: #cfc8e2;
    border: 1px solid rgba(120, 108, 170, 0.45);
    border-radius: 6px;
    padding: 4px 8px;
}

/* ----- Barre de titre ----- */

TitleBar#titleBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(6, 5, 11, 0.97), stop:0.5 rgba(14, 10, 24, 0.96), stop:1 rgba(6, 7, 13, 0.97));
    border-bottom: 1px solid rgba(156, 74, 122, 0.40);
    qproperty-iconColor: #9d95b8;               /* icônes réduire / agrandir / fermer */
}
TitleBar#titleBar[active="false"] { border-bottom: 1px solid rgba(120, 108, 170, 0.20); }

QLabel#titleLabel { color: #b77ea0; font-size: 9pt; font-weight: 600; }
TitleBar#titleBar[active="false"] QLabel#titleLabel { color: #615b7c; }

QMenuBar#titleMenuBar { background: transparent; color: #b5aecb; padding: 0px; spacing: 2px; }
TitleBar#titleBar[active="false"] QMenuBar#titleMenuBar { color: #615b7c; }
QMenuBar#titleMenuBar::item { background: transparent; padding: 5px 10px; border-radius: 7px; }
QMenuBar#titleMenuBar::item:selected { background-color: rgba(120, 108, 170, 0.20); color: #ffffff; }
QMenuBar#titleMenuBar::item:pressed  { background-color: rgba(156, 74, 122, 0.32); color: #ffffff; }

QPushButton#minimizeButton, QPushButton#maximizeButton, QPushButton#closeButton {
    background: transparent; border: none; border-radius: 0px; padding: 0px; margin: 0px;
}
QPushButton#minimizeButton:hover, QPushButton#maximizeButton:hover     { background-color: rgba(120, 108, 170, 0.20); }
QPushButton#minimizeButton:pressed, QPushButton#maximizeButton:pressed { background-color: rgba(120, 108, 170, 0.34); }
QPushButton#closeButton:hover   { background-color: #d9487f; }
QPushButton#closeButton:pressed { background-color: #b8336a; }

/* ----- Menus déroulants ----- */

QMenu {
    background-color: #0e0c17;
    color: #cfc8e2;
    border: 1px solid rgba(120, 108, 170, 0.40);
    padding: 5px;
}
QMenu::item { padding: 6px 30px 6px 12px; border-radius: 6px; background: transparent; }
QMenu::item:selected { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6e2752, stop:1 #3d3570); color: #ffffff; }
QMenu::item:disabled { color: #4d4866; }
QMenu::separator { height: 1px; background: rgba(120, 108, 170, 0.25); margin: 5px 8px; }
QMenu::indicator { width: 14px; height: 14px; margin-left: 4px; }
QMenu::right-arrow { margin-right: 6px; }

/* ----- Barre d'état ----- */

QStatusBar { background-color: rgba(6, 5, 11, 0.97); color: #a8884a; border-top: 1px solid rgba(120, 108, 170, 0.30); }
QStatusBar::item { border: none; }
QStatusBar QLabel { color: #a8884a; padding-right: 8px; }

QMessageBox { background-color: #0e0c17; }

/* =====================================================================
   Panneaux (Hierarchy / Inspector / Project / Console / Tile Palette)
   ===================================================================== */

QMainWindow::separator { background: transparent; width: 6px; height: 6px; }
QMainWindow::separator:hover { background: rgba(156, 74, 122, 0.45); }

QDockWidget { color: #cfc8e2; font-weight: 600; }
QDockWidget::title {
    background: rgba(10, 8, 18, 0.97);
    padding: 6px 10px;
    border: 1px solid rgba(120, 108, 170, 0.28);
    border-bottom: 2px solid #9c4a7a;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    text-align: left;
}
QWidget#hierarchyPanel, QWidget#inspectorPanel, QWidget#projectPanel,
QWidget#consolePanel, QWidget#tilePalettePanel {
    background: rgba(8, 7, 14, 0.93);
    border: 1px solid rgba(120, 108, 170, 0.26);
    border-top: none;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}
QDockWidget::close-button, QDockWidget::float-button { border: none; border-radius: 4px; padding: 2px; background: transparent; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background: rgba(120, 108, 170, 0.22); }

/* Onglets des panneaux empilés */
QTabBar { qproperty-drawBase: 0; }
QTabBar::tab {
    background: rgba(8, 7, 14, 0.92);
    color: #7a7398;
    border: 1px solid rgba(120, 108, 170, 0.26);
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 5px 14px;
    margin-right: 2px;
}
QTabBar::tab:selected { background: rgba(20, 16, 34, 0.98); color: #ffffff; border-color: #9c4a7a; }
QTabBar::tab:hover:!selected { color: #cfc8e2; background: rgba(120, 108, 170, 0.20); }

/* Listes et arbres */
QTreeView, QListView, QListWidget, QTreeWidget {
    background: rgba(4, 3, 8, 0.70);
    color: #cfc8e2;
    border: 1px solid rgba(120, 108, 170, 0.24);
    border-radius: 8px;
    padding: 3px;
    outline: none;
}
QTreeView::item, QListView::item { padding: 3px 4px; border-radius: 5px; }
QTreeView::item:hover, QListView::item:hover { background: rgba(120, 108, 170, 0.18); }
QTreeView::item:selected, QListView::item:selected { background: #6e2752; color: #ffffff; }
QTreeView { show-decoration-selected: 0; }
QTreeView::branch, QTreeView::branch:selected { background: transparent; }
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings { image: url(:/resources/icons/branch_closed.png); }
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings { image: url(:/resources/icons/branch_open.png); }

/* Champs */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit, QPlainTextEdit {
    background: rgba(3, 3, 7, 0.92);
    color: #d8d2ea;
    border: 1px solid rgba(120, 108, 170, 0.30);
    border-radius: 6px;
    padding: 3px 6px;
    selection-background-color: #6e2752;
    selection-color: #ffffff;
}
/* Pas de flèches sur les champs numériques (molette / clavier). Largeur ET hauteur à 0 :
   avec seulement width: 0, Qt 6.12 laisse les flèches recouvrir le texte du champ. */
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    width: 0px;
    height: 0px;
    border: none;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus,
QTextEdit:focus, QPlainTextEdit:focus { border: 1px solid #3f8e9e; }
QLineEdit:read-only, QDoubleSpinBox:read-only, QSpinBox:read-only { color: #7a7398; }
QComboBox QAbstractItemView {
    background: #0e0c17;
    color: #cfc8e2;
    border: 1px solid rgba(120, 108, 170, 0.40);
    selection-background-color: #6e2752;
    selection-color: #ffffff;
}

QPushButton {
    background: rgba(18, 15, 30, 0.95);
    color: #cfc8e2;
    border: 1px solid rgba(120, 108, 170, 0.32);
    border-radius: 7px;
    padding: 5px 12px;
}
QPushButton:hover   { border-color: #3f8e9e; background: rgba(28, 23, 46, 0.96); }
QPushButton:pressed { background: rgba(156, 74, 122, 0.40); }
QPushButton:disabled { color: #4d4866; }
QPushButton::menu-indicator { subcontrol-position: right center; right: 8px; }

QToolButton#panelToolButton, QToolButton#paletteTool,
QToolButton#consoleInfo, QToolButton#consoleWarning, QToolButton#consoleError {
    background: rgba(18, 15, 30, 0.95);
    color: #cfc8e2;
    border: 1px solid rgba(120, 108, 170, 0.30);
    border-radius: 6px;
    padding: 3px 9px;
    min-height: 18px;
}
QToolButton#panelToolButton:hover, QToolButton#paletteTool:hover { border-color: #9c4a7a; }
QToolButton#paletteTool:checked { background: #6e2752; border-color: #9c4a7a; color: #ffffff; }
QToolButton#consoleInfo:!checked, QToolButton#consoleWarning:!checked, QToolButton#consoleError:!checked {
    color: #615b7c;
    background: transparent;
}
QToolButton#consoleWarning:checked { color: #a8884a; }
QToolButton#consoleError:checked   { color: #ff7a9a; }

QCheckBox { color: #cfc8e2; spacing: 6px; }

QSplitter::handle { background: transparent; width: 5px; }
QSplitter::handle:hover { background: rgba(156, 74, 122, 0.45); }

/* Inspector */
QScrollArea#inspectorScroll, QWidget#inspectorContent { background: transparent; border: none; }
QLabel#inspectorEmpty { color: #7a7398; }
QLabel#inspectorId { color: #7a7398; padding: 0 4px; }
QLineEdit#inspectorName { font-weight: 600; padding: 5px 8px; }
QWidget#componentSection { background: rgba(12, 10, 20, 0.94); border: 1px solid rgba(120, 108, 170, 0.26); border-radius: 8px; }
QWidget#componentHeader { background: rgba(22, 18, 38, 0.96); border-top-left-radius: 8px; border-top-right-radius: 8px; }
QToolButton#componentToggle {
    background: transparent; border: none; color: #d8d2ea; font-weight: 600; padding: 4px 2px; text-align: left;
}
QToolButton#componentRemove { background: transparent; border: none; border-radius: 4px; color: #7a7398; padding: 2px 6px; }
QToolButton#componentRemove:hover { background: #d9487f; color: #ffffff; }
QWidget#componentBody QLabel { color: #8a83a8; }
QLabel#fieldLabel { color: #cfc8e2; }
QLabel#axisLabelX { color: #ff7a9a; font-weight: 600; }
QLabel#axisLabelY { color: #3f8e9e; font-weight: 600; }
QPushButton#addComponentButton { padding: 7px 12px; font-weight: 600; border-color: rgba(229, 185, 96, 0.55); color: #bfa064; }
QPushButton#addComponentButton:hover { border-color: #a8884a; }

/* Project / Tile Palette / Console */
QLabel#projectPath { color: #7a7398; padding-left: 4px; }
QLabel#paletteSectionTitle { color: #a8884a; font-weight: 600; }
QLabel#paletteHelp { color: #7a7398; font-size: 8pt; }
QListWidget#paletteTerrains::item { padding: 3px 6px; }
QListWidget#consoleList::item { padding: 1px 4px; border-radius: 3px; }

QScrollBar:vertical, QScrollBar:horizontal { background: transparent; border: none; margin: 0px; }
QScrollBar:vertical   { width: 10px; }
QScrollBar:horizontal { height: 10px; }
QScrollBar::handle { background: rgba(120, 108, 170, 0.40); border-radius: 4px; min-height: 24px; min-width: 24px; margin: 2px; }
QScrollBar::handle:hover { background: rgba(156, 74, 122, 0.60); }
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page { background: none; border: none; width: 0px; height: 0px; }

/* Fond de la vue scène / jeu (autour de la carte) */
SfmlWidget { qproperty-clearColor: #06050a; qproperty-backgroundImage: "none"; }
TilemapView { qproperty-backgroundImage: "none"; }

/* =====================================================================
   Fenêtres Input Manager / Systèmes
   ===================================================================== */
QDialog#inputSettingsDialog,
QDialog#systemsDialog { background-color: #0b0a12; }
QDialog#inputSettingsDialog QTableWidget,
QDialog#systemsDialog QTableWidget {
    background: #08070e;
    border: 1px solid rgba(120, 108, 170, 0.28);
    border-radius: 6px;
    gridline-color: transparent;
}
QDialog#inputSettingsDialog QHeaderView::section,
QDialog#systemsDialog QHeaderView::section {
    background: #0b0a12;
    color: #7a7398;
    border: none;
    border-bottom: 1px solid rgba(120, 108, 170, 0.28);
    padding: 4px 6px;
}
QDialog#inputSettingsDialog QTableWidget QToolButton,
QDialog#systemsDialog QTableWidget QToolButton { background: transparent; border: none; }
QDialog#inputSettingsDialog QLabel#hintLabel,
QDialog#systemsDialog QLabel#hintLabel { color: #7a7398; }
QDialog#inputSettingsDialog QPushButton[capturing="true"],
QDialog#systemsDialog QPushButton[capturing="true"] { border: 1px solid #a8884a; font-style: italic; }

/* Fenêtre « Tileset » (Tile Palette > + / Modifier) */
QDialog#tileDefDialog { background-color: #0b0a12; }
QDialog#tileDefDialog QLabel#hintLabel { color: #7a7398; }
QDialog#tileDefDialog QGroupBox {
    border: 1px solid rgba(120, 108, 170, 0.28);
    border-radius: 6px;
    margin-top: 14px;
    padding: 8px 6px 6px 6px;
}
QDialog#tileDefDialog QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #a8884a;
}
QDialog QScrollArea, QDialog QScrollArea > QWidget > QWidget { background: transparent; }

/* Menus et bulles : opaques (fenêtres à part) */
QMenu { background-color: #0e0c17; }
QToolTip { background-color: #100e1a; }
